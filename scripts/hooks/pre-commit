#!/bin/bash
# bashrs pre-commit hook.
#
# C52 item 3 (operator): a hook BLOCKS only if it is fast (<5 s), deterministic,
# auto-fixable AND mirrors a required CI check. Format is the only step that is.
# Clippy, perf lints and tests take longer than 5 s, so they WARN here and CI
# stays the enforcer.
set -u

echo "🔍 Running pre-commit quality checks..."

# Blocking: format (only when Rust files are staged).
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null)
if [ -n "$STAGED_RS" ]; then
    echo "  📐 Checking format..."
    if ! cargo fmt --all -- --check >/dev/null 2>&1; then
        echo ""
        echo "❌ COMMIT BLOCKED: unformatted Rust code"
        echo "   Fix: cargo fmt --all"
        exit 1
    fi
    echo "  ✅ Format"
fi

# Warn only: everything below can take minutes; CI enforces it.
warn_step() {
    label="$1"; shift
    echo "  ⏳ $label (warning only)..."
    if "$@" >/dev/null 2>&1; then
        echo "  ✅ $label"
    else
        echo "  ⚠️  $label failed (not blocking; CI enforces). Run: $*"
    fi
}

warn_step "clippy (zero warnings)" cargo clippy --lib -- -D warnings
warn_step "perf lints (release)" cargo clippy --release -- -W clippy::perf
warn_step "tests (fast: 50 prop cases)" env PROPTEST_CASES=50 cargo test --lib --quiet

echo ""
echo "✅ Pre-commit checks done"
echo ""
exit 0
